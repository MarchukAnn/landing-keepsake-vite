#subscribe.newsletter
  h2.footer__heading Newsletter
  p.newsletter__text Fresh case studies and design notes, once a month.
  //- Повідомлення про успіх показується через :target (form action="#done"), без JS
  p#done.newsletter__success(role='status')
    +icon('check', 24)
    | You’re in! Check your inbox to confirm.
  form.newsletter__form(action='#done', method='get')
    .newsletter__row
      label.visually-hidden(for='email') Email address
      input#email.newsletter__input(
        type='email',
        name='email',
        placeholder='Your email address',
        required,
        aria-describedby='email-error'
      )
      +btn('Subscribe')(type='submit')
      p#email-error.newsletter__error Please enter a valid email address.
    label.newsletter__agree
      input(type='checkbox', required)
      |
      | I agree to the privacy policy
